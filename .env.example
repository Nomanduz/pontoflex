# PontoFlex — configuração. Copie para .env e preencha. NUNCA versione o .env.

# ---------- Supabase (supabase.com → seu projeto → Project Settings → API) ----------
# Lidas pelo navegador:
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Lidas pelo servidor:
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Chave secreta (service role). Só no servidor; nunca com prefixo VITE_.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxx
# Para aplicar as migrações (bun run db:migrate): Project Settings → Database → Connection string (URI)
DATABASE_URL=postgresql://postgres:SENHA@db.SEU-PROJETO.supabase.co:5432/postgres

# ---------- Segurança ----------
# Segredo para assinar os tokens do terminal e das confirmações (mínimo 32 caracteres aleatórios).
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
APP_SECRET=

# Endereço público do app, usado nos links dos e-mails (ex.: https://pontoflex.nomanduz.com.br)
APP_URL=http://localhost:8080

# ---------- Reconhecimento facial (AWS Rekognition) ----------
# Crie um usuário IAM só com a política "AmazonRekognitionFullAccess" (ou a política mínima do README).
AWS_REGION=us-east-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Similaridade mínima para aceitar o rosto (80 a 99.9). Padrão 95.
FACE_SIMILARIDADE_MIN=95

# ---------- E-mail (escolha UMA opção) ----------
# Opção A — Gmail: ative a verificação em 2 etapas e crie uma "senha de app" em myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=academiadaprevencaobr@gmail.com
SMTP_PASS=
# Opção B — Resend (resend.com), recomendado quando tiver domínio próprio:
# RESEND_API_KEY=re_xxx
# EMAIL_FROM=PontoFlex <nao-responda@seudominio.com.br>

# Quem recebe as solicitações de cadastro de empresas e pode virar superadmin:
NOMANDUZ_ADMIN_EMAIL=academiadaprevencaobr@gmail.com
# Senha do superadmin ao rodar "bun run criar-superadmin" (opcional; se vazio, uma senha forte é gerada)
SUPERADMIN_SENHA=
